<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="orbit">
  <schema id="org.gnome.shell.extensions.orbit-dock" path="/org/gnome/shell/extensions/orbit-dock/">
    <!-- Placement -->
    <key name="dock-position" type="s">
      <choices><choice value="bottom"/><choice value="left"/><choice value="right"/><choice value="top"/></choices>
      <default>'bottom'</default>
      <summary>Screen edge the dock is attached to</summary>
    </key>
    <key name="multi-monitor" type="b">
      <default>false</default>
      <summary>Show a dock on every monitor</summary>
    </key>
    <key name="extend-to-edge" type="b">
      <default>false</default>
      <summary>Stretch the dock across the full edge (panel mode)</summary>
    </key>
    <key name="margin" type="i">
      <range min="0" max="64"/>
      <default>8</default>
      <summary>Gap between the dock and the screen edge</summary>
    </key>

    <!-- Behaviour -->
    <key name="dock-mode" type="s">
      <choices><choice value="fixed"/><choice value="manual"/><choice value="autohide"/><choice value="intellihide"/></choices>
      <default>'intellihide'</default>
      <summary>fixed reserves screen space; autohide hides until the pointer pushes the edge; intellihide hides only when a window overlaps</summary>
    </key>
    <key name="intellihide-scope" type="s">
      <choices><choice value="all-windows"/><choice value="focus-app"/><choice value="maximized"/></choices>
      <default>'all-windows'</default>
      <summary>Which windows make an intellihide dock get out of the way</summary>
    </key>
    <key name="pressure-threshold" type="i">
      <range min="0" max="1000"/>
      <default>100</default>
      <summary>Pointer pressure (px) at the edge needed to reveal a hidden dock</summary>
    </key>
    <key name="hide-delay" type="i">
      <range min="0" max="5000"/>
      <default>400</default>
      <summary>Delay in ms before hiding after the pointer leaves</summary>
    </key>
    <key name="animation-time" type="i">
      <range min="0" max="2000"/>
      <default>200</default>
      <summary>Show/hide animation duration in ms</summary>
    </key>
    <key name="hide-overview-dash" type="b">
      <default>true</default>
      <summary>Hide the stock dash in the Activities overview</summary>
    </key>

    <!-- Content -->
    <key name="icon-size" type="i">
      <range min="16" max="128"/>
      <default>48</default>
      <summary>Maximum icon size (shrinks automatically when the dock is full)</summary>
    </key>
    <key name="show-favorites" type="b">
      <default>true</default>
      <summary>Show pinned (favorite) applications</summary>
    </key>
    <key name="show-running" type="b">
      <default>true</default>
      <summary>Show running applications</summary>
    </key>
    <key name="show-apps-button" type="b">
      <default>true</default>
      <summary>Show the "Show Applications" button</summary>
    </key>
    <key name="show-apps-position" type="s">
      <choices><choice value="start"/><choice value="end"/><choice value="after-favorites"/></choices>
      <default>'end'</default>
      <summary>Where the "Show Applications" button sits: start, end, or between pinned and running apps</summary>
    </key>
    <key name="isolate-workspaces" type="b">
      <default>false</default>
      <summary>Only count windows on the current workspace</summary>
    </key>
    <key name="isolate-monitors" type="b">
      <default>false</default>
      <summary>Only count windows on the dock's monitor</summary>
    </key>

    <!-- Actions -->
    <key name="click-action" type="s">
      <choices><choice value="focus-or-minimize"/><choice value="cycle-windows"/><choice value="focus-or-minimize-all"/><choice value="previews"/><choice value="focus-or-previews"/><choice value="spread"/><choice value="launch"/></choices>
      <default>'focus-or-minimize'</default>
      <summary>What a left click on a running app does</summary>
    </key>
    <key name="middle-click-action" type="s">
      <choices><choice value="new-window"/><choice value="minimize"/><choice value="quit"/><choice value="none"/></choices>
      <default>'new-window'</default>
      <summary>What a middle click on an app does</summary>
    </key>
    <key name="scroll-action" type="s">
      <choices><choice value="cycle-windows"/><choice value="switch-workspace"/><choice value="none"/></choices>
      <default>'cycle-windows'</default>
      <summary>What scrolling over the dock does</summary>
    </key>

    <!-- Appearance -->
    <key name="indicator-style" type="s">
      <choices><choice value="dots"/><choice value="dot"/><choice value="line"/><choice value="squares"/><choice value="dashes"/><choice value="segmented"/><choice value="solid"/><choice value="metro"/><choice value="none"/></choices>
      <default>'dots'</default>
      <summary>Running indicator style (dots = one per window, up to 4)</summary>
    </key>
    <key name="background-opacity" type="d">
      <range min="0.0" max="1.0"/>
      <default>0.8</default>
      <summary>Dock background opacity</summary>
    </key>
    <key name="use-custom-color" type="b">
      <default>false</default>
      <summary>Use background-color instead of the theme colour</summary>
    </key>
    <key name="background-color" type="s">
      <default>'#242428'</default>
      <summary>Custom dock background colour (#rrggbb)</summary>
    </key>
    <key name="border-radius" type="i">
      <range min="0" max="64"/>
      <default>22</default>
      <summary>Dock corner radius in px</summary>
    </key>
    <!-- Top bar -->
    <key name="top-bar-style" type="s">
      <choices><choice value="default"/><choice value="dynamic"/><choice value="translucent"/></choices>
      <default>'default'</default>
      <summary>default = theme look; dynamic = transparent until a window touches it; translucent = always use the custom opacity</summary>
    </key>
    <key name="top-bar-dynamic-trigger" type="s">
      <choices><choice value="touching"/><choice value="maximized"/></choices>
      <default>'touching'</default>
      <summary>What makes a dynamic top bar turn solid</summary>
    </key>
    <key name="top-bar-solid-opacity" type="d">
      <range min="0.0" max="1.0"/>
      <default>1.0</default>
      <summary>Top bar opacity when solid</summary>
    </key>
    <key name="top-bar-transparent-opacity" type="d">
      <range min="0.0" max="1.0"/>
      <default>0.0</default>
      <summary>Top bar opacity when transparent (dynamic mode) or always (translucent mode)</summary>
    </key>
    <key name="top-bar-use-custom-color" type="b">
      <default>false</default>
      <summary>Use top-bar-color instead of black</summary>
    </key>
    <key name="top-bar-color" type="s">
      <default>'#000000'</default>
      <summary>Top bar background colour (#rrggbb)</summary>
    </key>
    <key name="top-bar-floating" type="b">
      <default>false</default>
      <summary>Draw the top bar as a floating rounded bar while it is transparent</summary>
    </key>
    <key name="top-bar-radius" type="i">
      <range min="0" max="32"/>
      <default>12</default>
      <summary>Corner radius of the floating top bar</summary>
    </key>
    <key name="top-bar-transition" type="i">
      <range min="0" max="2000"/>
      <default>250</default>
      <summary>Fade duration in ms when the top bar changes state</summary>
    </key>
    <key name="top-bar-hide-activities" type="b">
      <default>false</default>
      <summary>Hide the Activities / workspace button</summary>
    </key>
    <key name="top-bar-clock-position" type="s">
      <choices><choice value="center"/><choice value="left"/><choice value="right"/></choices>
      <default>'center'</default>
      <summary>Where the clock sits in the top bar</summary>
    </key>

    <!-- Launcher and overview -->
    <key name="super-key-action" type="s">
      <choices><choice value="overview"/><choice value="launcher"/><choice value="none"/></choices>
      <default>'overview'</default>
      <summary>What the Super key opens</summary>
    </key>
    <key name="activities-action" type="s">
      <choices><choice value="overview"/><choice value="launcher"/></choices>
      <default>'overview'</default>
      <summary>What clicking Activities opens</summary>
    </key>
    <key name="show-apps-action" type="s">
      <choices><choice value="overview"/><choice value="launcher"/></choices>
      <default>'overview'</default>
      <summary>What the dock's applications button opens</summary>
    </key>
    <key name="skip-startup-overview" type="b">
      <default>false</default>
      <summary>Go straight to the desktop after logging in</summary>
    </key>
    <key name="launcher-icon-size" type="i">
      <range min="16" max="64"/>
      <default>32</default>
      <summary>App icon size in the launcher</summary>
    </key>
    <key name="launcher-show-descriptions" type="b">
      <default>true</default>
      <summary>Show app descriptions under names in the launcher</summary>
    </key>
    <key name="launcher-show-power" type="b">
      <default>true</default>
      <summary>Show lock/log out/suspend/restart/power off buttons in the launcher</summary>
    </key>
    <key name="launcher-opacity" type="d">
      <range min="0.0" max="1.0"/>
      <default>0.92</default>
      <summary>Launcher background opacity</summary>
    </key>

    <!-- Glass / frost -->
    <key name="glass-dock" type="b">
      <default>false</default>
      <summary>Frosted glass behind the dock</summary>
    </key>
    <key name="glass-top-bar" type="b">
      <default>false</default>
      <summary>Frosted glass behind the top bar</summary>
    </key>
    <key name="glass-launcher" type="b">
      <default>false</default>
      <summary>Frosted glass behind the launcher</summary>
    </key>
    <key name="glass-blur-radius" type="i">
      <range min="0" max="100"/>
      <default>30</default>
      <summary>Blur strength in px</summary>
    </key>
    <key name="glass-brightness" type="d">
      <range min="0.0" max="1.0"/>
      <default>0.75</default>
      <summary>Brightness of the blurred background</summary>
    </key>
    <key name="glass-highlight" type="b">
      <default>true</default>
      <summary>Add a light frosted edge highlight to glass surfaces</summary>
    </key>
    <!-- Personalization -->
    <key name="tray-enabled" type="b">
      <default>false</default>
      <summary>Show AppIndicator / KStatusNotifier tray icons</summary>
    </key>
    <key name="tray-position" type="s">
      <choices><choice value="top-bar"/><choice value="bottom-left"/></choices>
      <default>'top-bar'</default>
      <summary>Where tray icons appear</summary>
    </key>
    <key name="tray-icon-size" type="i">
      <range min="12" max="48"/>
      <default>16</default>
      <summary>Tray icon size</summary>
    </key>
    <key name="app-button-enabled" type="b">
      <default>false</default>
      <summary>Show the focused application in the top bar</summary>
    </key>
    <key name="app-button-position" type="s">
      <choices><choice value="left"/><choice value="center"/><choice value="right"/></choices>
      <default>'left'</default>
      <summary>Where the focused-app button sits in the top bar</summary>
    </key>
    <key name="app-button-show-title" type="b">
      <default>false</default>
      <summary>Show the window title instead of the app name</summary>
    </key>
    <key name="app-button-show-icon" type="b">
      <default>true</default>
      <summary>Show the app icon on the focused-app button</summary>
    </key>
    <!-- Taskbar (Windows-style single bar) -->
    <key name="top-bar-position" type="s">
      <choices><choice value="top"/><choice value="bottom"/></choices>
      <default>'top'</default>
      <summary>Screen edge for GNOME's top bar</summary>
    </key>
    <key name="dock-in-panel" type="b">
      <default>false</default>
      <summary>Show the dock's apps inside the top bar (taskbar) instead of a separate dock</summary>
    </key>
    <key name="taskbar-alignment" type="s">
      <choices><choice value="left"/><choice value="center"/></choices>
      <default>'left'</default>
      <summary>Where the taskbar's apps sit in the bar</summary>
    </key>
    <key name="taskbar-icon-size" type="i">
      <range min="16" max="48"/>
      <default>24</default>
      <summary>App icon size in the taskbar</summary>
    </key>
    <key name="launcher-style" type="s">
      <choices><choice value="modern"/><choice value="list"/><choice value="minimal"/><choice value="classic"/><choice value="arc"/><choice value="xp"/><choice value="grid"/><choice value="runner"/><choice value="sidebar"/></choices>
      <default>'modern'</default>
      <summary>modern = search, pinned grid, All apps; list = one A–Z list; minimal = compact search box; classic = categories beside the list; arc = categories beside an app grid; xp = Windows XP start menu</summary>
    </key>
    <key name="top-bar-height" type="i">
      <range min="0" max="96"/>
      <default>0</default>
      <summary>Top bar (or bottom taskbar) height in px; 0 keeps the theme's height</summary>
    </key>
    <key name="launcher-xp-categories" type="b">
      <default>false</default>
      <summary>Windows XP menu: group All Programs into category folders</summary>
    </key>

    <!-- Window previews and additional dock controls -->
    <key name="window-previews" type="b"><default>true</default><summary>Show window previews on hover</summary></key>
    <key name="preview-delay" type="i"><range min="0" max="3000"/><default>400</default><summary>Hover delay before previews in milliseconds</summary></key>
    <key name="preview-size" type="i"><range min="120" max="480"/><default>240</default><summary>Preview width in logical pixels</summary></key>
    <key name="preview-titles" type="b"><default>true</default><summary>Show window titles above previews</summary></key>
    <key name="preview-peek" type="b"><default>false</default><summary>Dim other windows while hovering a preview</summary></key>
    <key name="preferred-monitor" type="i"><range min="-1" max="31"/><default>-1</default><summary>Dock monitor index; -1 follows the primary monitor</summary></key>
    <key name="favorites-primary-only" type="b"><default>false</default><summary>Show pinned apps only on the primary monitor</summary></key>
    <key name="shift-click-action" type="s">
      <choices><choice value="launch"/><choice value="focus-or-minimize"/><choice value="cycle-windows"/><choice value="focus-or-minimize-all"/><choice value="previews"/><choice value="focus-or-previews"/><choice value="spread"/></choices>
      <default>'launch'</default><summary>Shift-click action</summary>
    </key>
    <key name="shift-middle-click-action" type="s">
      <choices><choice value="new-window"/><choice value="minimize"/><choice value="quit"/><choice value="none"/></choices>
      <default>'new-window'</default><summary>Shift-middle-click action</summary>
    </key>
    <key name="show-desktop-button" type="b"><default>false</default><summary>Show a desktop toggle in the taskbar</summary></key>
    <key name="show-desktop-peek" type="b"><default>false</default><summary>Peek at the desktop on button hover</summary></key>
    <key name="group-apps" type="b"><default>true</default><summary>Group taskbar windows by application</summary></key>
    <key name="window-titles" type="b"><default>true</default><summary>Show titles on ungrouped taskbar buttons</summary></key>
    <key name="window-title-width" type="i"><range min="40" max="300"/><default>140</default><summary>Ungrouped window label width in logical pixels</summary></key>

    <!-- Dock parity controls -->
    <key name="number-shortcuts" type="b">
      <default>false</default><summary>Enable numbered app shortcuts</summary>
    </key>
    <key name="number-overlays" type="s">
<choices><choice value="never"/><choice value="temporary"/><choice value="always"/></choices>
      <default>'temporary'</default><summary>Show shortcut numbers</summary>
    </key>
    <key name="notification-badges" type="b">
      <default>true</default><summary>Show notification and launcher counts</summary>
    </key>
    <key name="launcher-progress" type="b">
      <default>true</default><summary>Show application-reported launcher progress</summary>
    </key>
    <key name="urgent-indicator" type="b">
      <default>true</default><summary>Highlight applications requesting attention</summary>
    </key>
    <key name="reveal-urgent" type="b">
      <default>true</default><summary>Reveal the standalone dock for urgent applications</summary>
    </key>
    <key name="show-trash" type="b">
      <default>false</default><summary>Show Trash in the dock</summary>
    </key>
    <key name="show-mounts" type="b">
      <default>false</default><summary>Show volumes in the dock</summary>
    </key>
    <key name="mounts-only-mounted" type="b">
      <default>true</default><summary>Show mounted volumes only</summary>
    </key>
    <key name="mounts-local" type="b">
      <default>true</default><summary>Include local volumes</summary>
    </key>
    <key name="mounts-network" type="b">
      <default>true</default><summary>Include network mounts</summary>
    </key>
    <key name="dock-opacity-mode" type="s">
<choices><choice value="fixed"/><choice value="dynamic"/></choices>
      <default>'fixed'</default><summary>Dock opacity mode</summary>
    </key>
    <key name="dock-min-opacity" type="d">
<range min="0" max="1"/>
      <default>0.25</default><summary>Dock opacity without nearby windows</summary>
    </key>
    <key name="indicator-size" type="i">
<range min="2" max="12"/>
      <default>5</default><summary>Indicator thickness in logical pixels</summary>
    </key>
    <key name="indicator-color" type="s">
      <default>'#deddda'</default><summary>Unfocused indicator color</summary>
    </key>
    <key name="indicator-focused-color" type="s">
      <default>'#3584e4'</default><summary>Focused indicator color</summary>
    </key>
    <key name="indicator-dominant-color" type="b">
      <default>false</default><summary>Use application icon colors for running indicators</summary>
    </key>
    <key name="fixed-icon-size" type="b">
      <default>false</default><summary>Keep configured icon size and scroll overflow</summary>
    </key>
    <key name="dock-length-limit" type="d">
<range min="0.2" max="1"/>
      <default>1.0</default><summary>Maximum fraction of screen edge used by the dock</summary>
    </key>
    <key name="show-delay" type="i">
<range min="0" max="3000"/>
      <default>150</default><summary>Delay before revealing at the screen edge in milliseconds</summary>
    </key>
    <key name="fullscreen-reveal" type="b">
      <default>true</default><summary>Allow edge and keyboard reveal over fullscreen windows</summary>
    </key>
    <key name="reveal-shortcut" type="as">
      <default>['&lt;Super&gt;&lt;Alt&gt;d']</default><summary>Reveal dock or toggle manual visibility</summary>
    </key>
    <key name="dock-app-1" type="as">
      <default>['&lt;Super&gt;&lt;Alt&gt;1']</default><summary>Activate dock application 1</summary>
    </key>
    <key name="dock-app-2" type="as">
      <default>['&lt;Super&gt;&lt;Alt&gt;2']</default><summary>Activate dock application 2</summary>
    </key>
    <key name="dock-app-3" type="as">
      <default>['&lt;Super&gt;&lt;Alt&gt;3']</default><summary>Activate dock application 3</summary>
    </key>
    <key name="dock-app-4" type="as">
      <default>['&lt;Super&gt;&lt;Alt&gt;4']</default><summary>Activate dock application 4</summary>
    </key>
    <key name="dock-app-5" type="as">
      <default>['&lt;Super&gt;&lt;Alt&gt;5']</default><summary>Activate dock application 5</summary>
    </key>
    <key name="dock-app-6" type="as">
      <default>['&lt;Super&gt;&lt;Alt&gt;6']</default><summary>Activate dock application 6</summary>
    </key>
    <key name="dock-app-7" type="as">
      <default>['&lt;Super&gt;&lt;Alt&gt;7']</default><summary>Activate dock application 7</summary>
    </key>
    <key name="dock-app-8" type="as">
      <default>['&lt;Super&gt;&lt;Alt&gt;8']</default><summary>Activate dock application 8</summary>
    </key>
    <key name="dock-app-9" type="as">
      <default>['&lt;Super&gt;&lt;Alt&gt;9']</default><summary>Activate dock application 9</summary>
    </key>
    <key name="dock-app-10" type="as">
      <default>['&lt;Super&gt;&lt;Alt&gt;0']</default><summary>Activate dock application 10</summary>
    </key>

    <!-- Native desktop icons -->
    <key name="desktop-icons-enabled" type="b">
      <default>false</default><summary>Show native desktop icons</summary>
    </key>
    <key name="desktop-show-files" type="b">
      <default>true</default><summary>Show files from the Desktop folder</summary>
    </key>
    <key name="desktop-show-hidden" type="b">
      <default>false</default><summary>Include hidden files on the desktop</summary>
    </key>
    <key name="desktop-show-home" type="b">
      <default>true</default><summary>Show Home on the desktop</summary>
    </key>
    <key name="desktop-show-trash" type="b">
      <default>true</default><summary>Show Trash on the desktop</summary>
    </key>
    <key name="desktop-show-drives" type="b">
      <default>false</default><summary>Show mounted drives and network locations</summary>
    </key>
    <key name="desktop-primary-only" type="b">
      <default>true</default><summary>Use the primary monitor only</summary>
    </key>
    <key name="desktop-icon-size" type="i">
<range min="24" max="128"/>
      <default>48</default><summary>Desktop icon size in logical pixels</summary>
    </key>
    <key name="desktop-label-size" type="i">
<range min="8" max="24"/>
      <default>11</default><summary>Desktop label font size</summary>
    </key>
    <key name="desktop-label-color" type="s">
      <default>'#ffffff'</default><summary>Desktop label color</summary>
    </key>
    <key name="desktop-label-shadow" type="b">
      <default>true</default><summary>Draw a shadow behind desktop labels</summary>
    </key>
    <key name="desktop-grid-spacing" type="i">
<range min="0" max="64"/>
      <default>12</default><summary>Extra space between desktop icons</summary>
    </key>
    <key name="desktop-sort-order" type="s">
<choices><choice value="manual"/><choice value="name"/><choice value="name-desc"/><choice value="modified"/><choice value="modified-desc"/><choice value="size"/><choice value="size-desc"/><choice value="type"/></choices>
      <default>'name'</default><summary>Desktop icon sort order</summary>
    </key>
    <key name="desktop-folders-first" type="b">
      <default>true</default><summary>Keep folders ahead of regular files</summary>
    </key>
    <key name="desktop-start-corner" type="s">
<choices><choice value="top-left"/><choice value="top-right"/><choice value="bottom-left"/><choice value="bottom-right"/></choices>
      <default>'top-left'</default><summary>First corner for desktop icons</summary>
    </key>
    <key name="desktop-flow" type="s">
<choices><choice value="vertical"/><choice value="horizontal"/></choices>
      <default>'vertical'</default><summary>Fill desktop columns or rows</summary>
    </key>
    <key name="desktop-single-click" type="b">
      <default>false</default><summary>Open desktop icons with a single click</summary>
    </key>
    <key name="desktop-home-icon" type="s">
      <default>'user-home'</default><summary>Home icon theme name or image path</summary>
    </key>
    <key name="desktop-trash-icon" type="s">
      <default>'user-trash'</default><summary>Trash icon theme name or image path</summary>
    </key>
    <key name="desktop-icon-positions" type="s">
      <default>'{}'</default><summary>Saved manual desktop positions</summary>
    </key>

    <!-- Independent taskbars -->
    <key name="taskbar-position" type="s">
<choices><choice value="follow"/><choice value="bottom"/><choice value="top"/><choice value="left"/><choice value="right"/></choices>
      <default>'follow'</default><summary>Taskbar screen edge</summary>
    </key>
    <key name="taskbar-size" type="i">
<range min="0" max="128"/>
      <default>0</default><summary>Panel thickness; zero follows the Top Bar height</summary>
    </key>
    <key name="taskbar-length" type="d">
<range min="0.2" max="1"/>
      <default>1.0</default><summary>Taskbar length as a fraction of the monitor</summary>
    </key>
    <key name="taskbar-anchor" type="s">
<choices><choice value="start"/><choice value="center"/><choice value="end"/></choices>
      <default>'start'</default><summary>Panel alignment along its edge</summary>
    </key>
    <key name="taskbar-mode" type="s">
<choices><choice value="fixed"/><choice value="autohide"/><choice value="intellihide"/></choices>
